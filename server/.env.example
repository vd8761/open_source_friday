PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/open_source_friday
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start
RECAPTCHA_SECRET_KEY=
VAPID_EMAIL=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Zoom Server-to-Server OAuth app (server only; never use VITE_ prefixes)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Bulk invitation campaigns (backend only). Drafts never send until admin clicks Start.
PUBLIC_APP_URL=https://osf.descienceosclub.com
SENDER_API_TOKEN=
SENDER_FROM_EMAIL=info@descienceosclub.com
SENDER_FROM_NAME=Descience Open Source Club
# Use the real organization mailing address shown in invitation footers.
SENDER_POSTAL_ADDRESS=

# v2.0 safety flags. Outside OSF_ENV=production every integration is off unless set to "true".
OSF_ENV=development
ENABLE_WORKERS=
ENABLE_ZOOM=
ENABLE_SENDER=
ENABLE_PUSH=
# Comma-separated. Outside production, Zoom enrolls only these emails; push reaches only these push_subscriptions ids.
ZOOM_TEST_ALLOWLIST=
PUSH_TEST_ALLOWLIST=
# External scheduler auth for /api/cron/* (see docs/v2/scheduler-setup.md).
CRON_SECRET=
CRON_GRACE_MINUTES=10
RECAPTCHA_MIN_SCORE=0.5

# Phase 4 security. Extra browser origins allowed to call the API (comma-separated, exact match).
# The live site, the mobile app, and (outside production) localhost and this project's Vercel previews are built in.
ALLOWED_ORIGINS=
# Requests per minute per IP. Defaults shown.
LOGIN_LIMIT_PER_MINUTE=5
LOOKUP_LIMIT_PER_MINUTE=10
REGISTER_LIMIT_PER_MINUTE=10
