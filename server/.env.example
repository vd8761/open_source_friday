PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/open_source_friday
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start
RECAPTCHA_SECRET_KEY=
VAPID_EMAIL=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Zoom Server-to-Server OAuth app (server only; never use VITE_ prefixes)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Bulk invitation campaigns (backend only). Drafts never send until admin clicks Start.
PUBLIC_APP_URL=https://osf.descienceosclub.com
SENDER_API_TOKEN=
SENDER_FROM_EMAIL=info@descienceosclub.com
SENDER_FROM_NAME=Descience Open Source Club
# Use the real organization mailing address shown in invitation footers.
SENDER_POSTAL_ADDRESS=
