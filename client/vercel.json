{
  "rewrites": [
    {
      "source": "/register/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebookcatalog|whatsapp|telegram|slack|discord|linkedin|twitter|pinterest|embedly|skype|vkshare|quora|redditbot|applebot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/episodes/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebookcatalog|whatsapp|telegram|slack|discord|linkedin|twitter|pinterest|embedly|skype|vkshare|quora|redditbot|applebot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/og?page=recap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
